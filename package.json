{
  "name": "@inixiative/agent-session",
  "version": "0.2.0",
  "description": "Drive coding-agent CLIs as persistent, streaming, event-captured sessions over interchangeable transports, with primed decision sessions, subscription pools, routing, limit polling and continuity.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run test",
    "prepublishOnly": "bun run check",
    "measure:primed": "bun scripts/measure-primed.ts"
  },
  "keywords": [
    "claude-code",
    "codex",
    "agent",
    "session",
    "stream",
    "stream-json",
    "ai",
    "cli",
    "sandbox",
    "harness",
    "eval"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "6.0.3"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inixiative/agent-session.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
