{
  "name": "@inixiative/agent-session",
  "version": "0.6.8",
  "description": "Drive coding-agent CLIs as persistent, streaming, event-captured sessions over interchangeable transports, with primed decision sessions, subscription pools, routing, limit polling and continuity.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./routing": "./src/routing.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test",
    "prepublishOnly": "bun run check",
    "measure:primed": "bun scripts/measure-primed.ts",
    "lint": "biome check .",
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi"
  },
  "keywords": [
    "claude-code",
    "codex",
    "agent",
    "session",
    "stream",
    "stream-json",
    "ai",
    "cli",
    "sandbox",
    "harness",
    "eval"
  ],
  "license": "MIT",
  "dependencies": {
    "@inixiative/json-rules": "^3.15.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@inixiative/config": "^0.5.143",
    "@types/bun": "1.4.4",
    "lefthook": "2.1.9",
    "typescript": "6.0.3"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inixiative/agent-session.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
